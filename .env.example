# 全部为服务端变量；复制到本机被忽略的 .env.local 后填写。
# 这是配置示例，应用会在开发阶段实现读取逻辑。
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# 本地 ima 官方完整解压目录内 ima_api.cjs 的实际路径。
IMA_SKILL_PATH=
# 可选使用者自填别名，不得标为接口验证过的账号昵称。
IMA_ACCOUNT_LABEL=
# 由主控按实际可用提供商确认，不能假定已配置。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
APP_DATA_DIR=.local-data
# 合成演示必须明确标注；正常运行默认关闭。
APP_ENABLE_SYNTHETIC=false

